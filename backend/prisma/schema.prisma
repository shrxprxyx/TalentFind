generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  FREELANCER
  CLIENT
  BOTH
}

enum ProjectType {
  FIXED
  HOURLY
}

enum ProposalStatus {
  PENDING
  ACCEPTED
  REJECTED
}

model User {
  id           String      @id @default(cuid())
  clerkId      String      @unique
  email        String      @unique
  name         String?
  image        String?
  role         Role?
  bio          String?
  hourlyRate   Int?
  availability String?     @default("FULL_TIME")
  skills       String[]    @default([])
  createdAt    DateTime    @default(now())
  portfolios   Portfolio[]
  projects     Project[]
  proposals    Proposal[]
}

model Portfolio {
  id          String   @id @default(cuid())
  title       String
  description String
  image       String?
  githubUrl   String?
  liveUrl     String?
  techStack   String[]
  createdAt   DateTime @default(now())
  userId      String
  user        User     @relation(fields: [userId], references: [id])
}

model Project {
  id          String      @id @default(cuid())
  title       String
  description String
  budget      Int
  skills      String[]
  deadline    DateTime
  projectType ProjectType @default(FIXED)
  createdAt   DateTime    @default(now())
  clientId    String
  client      User        @relation(fields: [clientId], references: [id])
  proposals   Proposal[]
}

model Proposal {
  id           String         @id @default(cuid())
  bidAmount    Int
  timeline     String
  coverLetter  String
  status       ProposalStatus @default(PENDING)
  createdAt    DateTime       @default(now())
  freelancerId String
  freelancer   User           @relation(fields: [freelancerId], references: [id])
  projectId    String
  project      Project        @relation(fields: [projectId], references: [id])
}
